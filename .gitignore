# Java / Maven
backend/target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# Python — cache bytecode do chay cac script trong scripts/ sinh ra
__pycache__/
*.pyc

# Node / Angular
node_modules/
frontend/dist/
frontend/.angular/
npm-debug.log*

# Bí mật — không bao giờ commit. Chỉ .env.example được theo dõi.
.env
.env.*
!.env.example

# Ảnh do người dùng tải lên khi chạy LocalImageStorage
uploads/

# IDE
.idea/
.vscode/
*.iml

# Hệ điều hành
.DS_Store
Thumbs.db

# Mat khau quan tri sinh ra khi quay video trinh dien. Khong bao gio commit.
.demo-new-pw
thesis/abs/.demo-new-pw
# Ban webm goc cua video trinh dien: dung lai duoc tu scripts/quay-demo.mjs,
# va da co ban .mp4 nho hon mot phan nam trong repo.
thesis/abs/*.webm
# Thu muc tam cua Playwright luc dang quay. Script tu xoa khi quay xong; dong
# nay la de phong truong hop quay hong giua chung va no con lai.
thesis/abs/.video-tmp/

# Tep nen de nop LMS — dung lai duoc bang scripts/dong-goi-nop-bai.sh
thesis/nop-bai/
